{
  "manifest_version": 3,
  "name": "Organife",
  "version": "1.1.1",
  "description": "Controle de Acesso",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "downloads",
    "identity",
    "history",
    "bookmarks",
    "activeTab",
    "scripting",
    "management",
    "system.display",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http: https: ws: wss:"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png", 
      "128": "icons/icon16.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon16.png",
    "128": "icons/icon16.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "intranet.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "identity.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "incognito": "split",
  "browser_specific_settings": {
    "gecko": {
      "id": "{activity-tracker-blocker}",
      "strict_min_version": "109.0"
    },
    "edge": {
      "browser_action_next_to_addressbar": true
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
